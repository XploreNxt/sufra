{
  "expo": {
    "name": "Surfa",
    "slug": "surfa-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E9F3EC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.surfa.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ionicons.ttf", "./assets/fonts/FontAwesome.ttf"]
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
